# ============================================================
#  MAKPHALT DMS — Backend environment
#  Copy this file to ".env" and fill in the 5 marked blanks.
#  Your project ref & URL are already filled in (they're public).
#  NEVER commit .env — it is gitignored.
# ============================================================

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173


# ── Supabase Postgres ───────────────────────────────────────
# DATABASE_URL = pooled connection (port 6543) — used by the running app.
# DIRECT_URL   = direct connection (port 5432) — used by `prisma migrate`.
#
#   Supabase dashboard → Settings → Database → Connection string.
#   Use the "URI" value. Replace [YOUR-PASSWORD] with your DB password
#   (letters + numbers only — no @ # $ % — or the URL will break).
#
#   Your project ref is:  rjmlsnjamkaopyosxfxk
#   Pick your region below (Mumbai = ap-south-1). Swap the host if different.
#
# >>> BLANK 1: paste your DB password in BOTH lines where it says YOUR-PASSWORD

DATABASE_URL="postgresql://postgres.rjmlsnjamkaopyosxfxk:20261344Deeepu@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres:20261344Deeepu@db.rjmlsnjamkaopyosxfxk.supabase.co:5432/postgres"


# ── JWT ─────────────────────────────────────────────────────
# >>> BLANK 2: any long random string (e.g. run: openssl rand -hex 32)
JWT_SECRET="paste-a-long-random-string-here"
JWT_EXPIRES_IN=7d


# ── Seed admin (created by: npm run db:seed) ────────────────
# This becomes your first login. Change the password.
SEED_ADMIN_NAME="Rishabh Jaini"
SEED_ADMIN_USERNAME="rishabhjaini"
SEED_ADMIN_EMAIL="rishabh@makphalt.com"
# >>> BLANK 3: choose your admin password
SEED_ADMIN_PASSWORD="rishabh@123"


# ── Supabase Storage ────────────────────────────────────────
# URL is pre-filled (public). Paste your NEW service_role key (secret).
#   Dashboard → Settings → API → Project API keys → service_role
SUPABASE_URL="https://rjmlsnjamkaopyosxfxk.supabase.co"
# >>> BLANK 4: paste your NEW (rotated) service_role key
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJqbWxzbmphbWthb3B5b3N4ZnhrIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NTY1MTg3OSwiZXhwIjoyMTAxMjI3ODc5fQ.2uagxPLYJ5deV9pZRJqiHDsDCo08P3fhpH9IeW0lfp4"
SUPABASE_BUCKET="Documents"


# ── Upload limits ───────────────────────────────────────────
MAX_FILE_SIZE_MB=3


# ── AI provider: ollama | gemini | openai ───────────────────
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
# >>> BLANK 5 (optional): only if you switch AI_PROVIDER above
GEMINI_API_KEY=""
OPENAI_API_KEY=""
